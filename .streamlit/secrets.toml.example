# ============================================================
# Streamlit Cloud Secrets
# Copy this to .streamlit/secrets.toml for local dev,
# or paste into Streamlit Cloud → App Settings → Secrets.
# ============================================================

# Supabase connection (use the anon/public key for read-only dashboard access)
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "eyJ..."   # anon (public) key — safe to use in client-side reads

# Dashboard password gate
DASHBOARD_PASSWORD = "REVENT_DASH_2024"
