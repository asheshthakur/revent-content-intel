# ============================================================
# Streamlit Cloud Secrets
# Copy this to .streamlit/secrets.toml for local dev,
# or paste into Streamlit Cloud → App Settings → Secrets.
# ============================================================

# Supabase connection (use the anon/public key for read-only dashboard access)
SUPABASE_URL = "https://YOUR_PROJECT.supabase.co"
SUPABASE_KEY = "eyJ..."   # anon (public) key — safe to use in client-side reads

# Dashboard password gate
DASHBOARD_PASSWORD = "REVENT_DASH_2024"

# ── Free-tier API Credentials (Optional) ─────────────────────
# YouTube Data API v3 key (Google Cloud Console free tier)
# youtube_api_key = "AIzaSy..."
# Or use YOUTUBE_API_KEY = "AIzaSy..."

# Reddit API client credentials (https://www.reddit.com/prefs/apps free script app)
# reddit_client_id = "your-client-id"
# reddit_client_secret = "your-client-secret"
# reddit_user_agent = "revent-content-intel:v1.0 (by /u/revent_bot)"

# ── Email Alerting via SMTP (Optional) ───────────────────────
# Gmail App Password or SMTP credentials for alert emails
# smtp_email = "alerts@revent.store"
# smtp_password = "your-16-char-app-password"
